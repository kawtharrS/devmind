{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.11 -c \"import sys,json,subprocess; d=json.load(sys.stdin); p=d.get('tool_input',{}).get('file_path',''); p.endswith('.py') and subprocess.run(['py','-3.11','scripts/strip_docstrings.py',p])\""
          }
        ]
      }
    ]
  }
}
